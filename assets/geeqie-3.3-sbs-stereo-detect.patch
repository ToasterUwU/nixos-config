+/*
+ *-----------------------------------------------------------------------------
+ * stereo utils
+ *-----------------------------------------------------------------------------
+ */
+
+namespace
+{
+
+/**
+ * @brief Downscaled luminance grid of one half of a side-by-side image
+ *
+ * Each cell is the mean of SUB x SUB sample points, so only a small
+ * fraction of the pixels is read, independent of the image size.
+ */
+std::vector<gdouble> stereo_luma_grid(const guchar *pixels, gint rowstride, gint channels,
+                                      gint x0, gint half_w, gint h, gint grid_w, gint grid_h)
+{
+	constexpr gint SUB = 4;
+	std::vector<gdouble> grid(static_cast<size_t>(grid_w) * grid_h);
+
+	for (gint gy = 0; gy < grid_h; gy++)
+		{
+		for (gint gx = 0; gx < grid_w; gx++)
+			{
+			guint sum = 0;
+			for (gint sy = 0; sy < SUB; sy++)
+				{
+				const gint y = std::min(h - 1, static_cast<gint>((gy + ((sy + 0.5) / SUB)) * h / grid_h));
+				const guchar *row = pixels + (static_cast<gsize>(y) * rowstride);
+				for (gint sx = 0; sx < SUB; sx++)
+					{
+					const gint x = x0 + std::min(half_w - 1, static_cast<gint>((gx + ((sx + 0.5) / SUB)) * half_w / grid_w));
+					const guchar *p = row + (static_cast<gsize>(x) * channels);
+					/* Rec. 601 luma, integer weights */
+					sum += (299 * p[0]) + (587 * p[1]) + (114 * p[2]);
+					}
+				}
+			grid[(static_cast<size_t>(gy) * grid_w) + gx] = sum / (1000.0 * SUB * SUB);
+			}
+		}
+
+	return grid;
+}
+
+gdouble stereo_grid_stddev(const std::vector<gdouble> &grid)
+{
+	gdouble sum = 0.0;
+	gdouble sum_sq = 0.0;
+	for (const gdouble v : grid)
+		{
+		sum += v;
+		sum_sq += v * v;
+		}
+	const auto n = static_cast<gdouble>(grid.size());
+	return std::sqrt(std::max(0.0, (sum_sq / n) - ((sum / n) * (sum / n))));
+}
+
+/**
+ * @brief Normalized cross-correlation of left[y][x] and right[y + dy][x + dx] over their overlap
+ */
+gdouble stereo_grid_ncc(const std::vector<gdouble> &left, const std::vector<gdouble> &right,
+                        gint grid_w, gint grid_h, gint dx, gint dy)
+{
+	const gint y_start = std::max(0, -dy);
+	const gint y_end = grid_h - std::max(0, dy);
+	const gint x_start = std::max(0, -dx);
+	const gint x_end = grid_w - std::max(0, dx);
+
+	gdouble n = 0.0;
+	gdouble sa = 0.0;
+	gdouble sb = 0.0;
+	gdouble saa = 0.0;
+	gdouble sbb = 0.0;
+	gdouble sab = 0.0;
+
+	for (gint y = y_start; y < y_end; y++)
+		{
+		for (gint x = x_start; x < x_end; x++)
+			{
+			const gdouble a = left[(static_cast<size_t>(y) * grid_w) + x];
+			const gdouble b = right[(static_cast<size_t>(y + dy) * grid_w) + x + dx];
+			n += 1.0;
+			sa += a;
+			sb += b;
+			saa += a * a;
+			sbb += b * b;
+			sab += a * b;
+			}
+		}
+
+	if (n < 1.0) return 0.0;
+
+	const gdouble cov = sab - (sa * sb / n);
+	const gdouble var_a = saa - (sa * sa / n);
+	const gdouble var_b = sbb - (sb * sb / n);
+	const gdouble denom = std::sqrt(std::max(0.0, var_a * var_b));
+
+	return denom > 1e-9 ? cov / denom : 0.0;
+}
+
+gdouble stereo_grid_best_ncc(const std::vector<gdouble> &left, const std::vector<gdouble> &right,
+                             gint grid_w, gint grid_h, gint max_dx, gint dy)
+{
+	gdouble best = -1.0;
+	for (gint dx = -max_dx; dx <= max_dx; dx++)
+		{
+		best = std::max(best, stereo_grid_ncc(left, right, grid_w, grid_h, dx, dy));
+		}
+	return best;
+}
+
+/**
+ * @brief Fine detail of a grid: each cell minus the mean of its 3 x 3 neighbourhood
+ */
+std::vector<gdouble> stereo_grid_detail(const std::vector<gdouble> &grid, gint grid_w, gint grid_h)
+{
+	std::vector<gdouble> detail(grid.size());
+
+	for (gint y = 0; y < grid_h; y++)
+		{
+		for (gint x = 0; x < grid_w; x++)
+			{
+			gdouble sum = 0.0;
+			for (gint ny = y - 1; ny <= y + 1; ny++)
+				{
+				const gint cy = std::clamp(ny, 0, grid_h - 1);
+				for (gint nx = x - 1; nx <= x + 1; nx++)
+					{
+					sum += grid[(static_cast<size_t>(cy) * grid_w) + std::clamp(nx, 0, grid_w - 1)];
+					}
+				}
+			const size_t i = (static_cast<size_t>(y) * grid_w) + x;
+			detail[i] = grid[i] - (sum / 9.0);
+			}
+		}
+
+	return detail;
+}
+
+/**
+ * @brief Correlation of left[y][x] and right[y + dy][x + dx] with a separate horizontal shift for each block
+ *
+ * Objects at different distances have different parallax, so each BLOCK x BLOCK block
+ * gets the horizontal shift (within +-max_dx) that matches best. The covariances and variances
+ * at these shifts are then pooled over all blocks, so blocks with more detail count more.
+ */
+gdouble stereo_grid_local_ncc(const std::vector<gdouble> &left, const std::vector<gdouble> &right,
+                              gint grid_w, gint grid_h, gint max_dx, gint dy)
+{
+	constexpr gint BLOCK = 8;
+	constexpr gdouble N = BLOCK * BLOCK;
+
+	gdouble cov_sum = 0.0;
+	gdouble var_l_sum = 0.0;
+	gdouble var_r_sum = 0.0;
+
+	for (gint by = 0; by + BLOCK <= grid_h; by += BLOCK)
+		{
+		if (by + dy < 0 || by + dy + BLOCK > grid_h) continue;
+
+		for (gint bx = 0; bx + BLOCK <= grid_w; bx += BLOCK)
+			{
+			gboolean found = FALSE;
+			gdouble best_ncc = 0.0;
+			gdouble best_cov = 0.0;
+			gdouble best_var_l = 0.0;
+			gdouble best_var_r = 0.0;
+
+			for (gint dx = -max_dx; dx <= max_dx; dx++)
+				{
+				if (bx + dx < 0 || bx + dx + BLOCK > grid_w) continue;
+
+				gdouble sa = 0.0;
+				gdouble sb = 0.0;
+				gdouble saa = 0.0;
+				gdouble sbb = 0.0;
+				gdouble sab = 0.0;
+				for (gint y = by; y < by + BLOCK; y++)
+					{
+					const gdouble *a_row = left.data() + (static_cast<size_t>(y) * grid_w);
+					const gdouble *b_row = right.data() + (static_cast<size_t>(y + dy) * grid_w) + dx;
+					for (gint x = bx; x < bx + BLOCK; x++)
+						{
+						const gdouble a = a_row[x];
+						const gdouble b = b_row[x];
+						sa += a;
+						sb += b;
+						saa += a * a;
+						sbb += b * b;
+						sab += a * b;
+						}
+					}
+
+				const gdouble cov = sab - (sa * sb / N);
+				const gdouble var_l = saa - (sa * sa / N);
+				const gdouble var_r = sbb - (sb * sb / N);
+				const gdouble denom = std::sqrt(std::max(0.0, var_l * var_r));
+				const gdouble ncc = denom > 1e-12 ? cov / denom : -1.0;
+
+				if (!found || ncc > best_ncc)
+					{
+					found = TRUE;
+					best_ncc = ncc;
+					best_cov = cov;
+					best_var_l = var_l;
+					best_var_r = var_r;
+					}
+				}
+
+			if (found)
+				{
+				cov_sum += best_cov;
+				var_l_sum += best_var_l;
+				var_r_sum += best_var_r;
+				}
+			}
+		}
+
+	const gdouble denom = std::sqrt(std::max(0.0, var_l_sum * var_r_sum));
+	return denom > 1e-12 ? cov_sum / denom : 0.0;
+}
+
+} // namespace
