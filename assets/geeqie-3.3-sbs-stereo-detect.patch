+/**
+ * @brief Detect a full-width side-by-side stereo pair by image content
+ * @param pixbuf A completely loaded image
+ * @returns TRUE if the left and right halves show the same scene from two horizontally offset viewpoints
+ *
+ * Only wide images are examined (aspect ratio 1.8 to 5.0, that is 0.9:1 to 2.5:1 per eye).
+ * Both halves are reduced to a small luminance grid. Parallax moves objects horizontally only,
+ * so all comparisons search a horizontal shift of up to +-15 % of the width. Three tests must pass:
+ * 1. Global similarity: the normalized cross-correlation of the halves is high.
+ * 2. Similar fine detail: the halves still correlate when only the fine detail is compared
+ *    (each cell minus its neighbourhood mean), with a separate shift for each block because
+ *    near and far objects have different parallax. This rejects images whose halves are similar
+ *    only in smooth areas, such as gradients and sky.
+ * 3. Vertical alignment: the detail correlates better at a vertical offset of zero than at small
+ *    vertical offsets, because the views of a stereo pair are vertically aligned.
+ * Images without texture are never detected.
+ *
+ * The cost does not depend on the image size: for a 16:9 pair, approximately 130 000 pixel reads,
+ * and a few milliseconds at most.
+ */
+gboolean pixbuf_detect_side_by_side_stereo(GdkPixbuf *pixbuf)
+{
+	constexpr gdouble MIN_ASPECT = 1.8;
+	constexpr gdouble MAX_ASPECT = 5.0;
+	constexpr gint GRID_H = 48;
+	constexpr gint GRID_W_MIN = 24;
+	constexpr gint GRID_W_MAX = 128;
+	constexpr gdouble MAX_SHIFT = 0.15;
+	constexpr std::array<gint, 6> CONTROL_DY{-4, -3, -2, 2, 3, 4};
+	constexpr gdouble MIN_TEXTURE = 3.0;
+	constexpr gdouble MIN_DETAIL_TEXTURE = 1.5;
+	constexpr gdouble MIN_CORRELATION = 0.85;
+	constexpr gdouble MIN_DETAIL_CORRELATION = 0.50;
+
+	if (!pixbuf) return FALSE;
+	if (gdk_pixbuf_get_colorspace(pixbuf) != GDK_COLORSPACE_RGB) return FALSE;
+	if (gdk_pixbuf_get_bits_per_sample(pixbuf) != 8) return FALSE;
+
+	const gint channels = gdk_pixbuf_get_n_channels(pixbuf);
+	if (channels < 3) return FALSE;
+
+	const gint w = gdk_pixbuf_get_width(pixbuf);
+	const gint h = gdk_pixbuf_get_height(pixbuf);
+	if (w < 2 * GRID_W_MIN || h < GRID_H) return FALSE;
+
+	const gdouble aspect = static_cast<gdouble>(w) / h;
+	if (aspect < MIN_ASPECT || aspect > MAX_ASPECT) return FALSE;
+
+	const gint half_w = w / 2;
+	const gint grid_w = std::clamp(static_cast<gint>(std::lround(GRID_H * static_cast<gdouble>(half_w) / h)),
+	                               GRID_W_MIN, GRID_W_MAX);
+
+	const guchar *pixels = gdk_pixbuf_read_pixels(pixbuf);
+	const gint rowstride = gdk_pixbuf_get_rowstride(pixbuf);
+
+	const std::vector<gdouble> left = stereo_luma_grid(pixels, rowstride, channels, 0, half_w, h, grid_w, GRID_H);
+	const std::vector<gdouble> right = stereo_luma_grid(pixels, rowstride, channels, half_w, half_w, h, grid_w, GRID_H);
+
+	if (std::min(stereo_grid_stddev(left), stereo_grid_stddev(right)) < MIN_TEXTURE) return FALSE;
+
+	const gint max_dx = std::max(1, static_cast<gint>(grid_w * MAX_SHIFT));
+
+	/* 1. global similarity */
+	const gdouble global = stereo_grid_best_ncc(left, right, grid_w, GRID_H, max_dx, 0);
+	if (global < MIN_CORRELATION)
+		{
+		DEBUG_1("side-by-side stereo detection: %dx%d global %.3f -> mono", w, h, global);
+		return FALSE;
+		}
+
+	/* 2. similar fine detail */
+	const std::vector<gdouble> left_detail = stereo_grid_detail(left, grid_w, GRID_H);
+	const std::vector<gdouble> right_detail = stereo_grid_detail(right, grid_w, GRID_H);
+	if (std::min(stereo_grid_stddev(left_detail), stereo_grid_stddev(right_detail)) < MIN_DETAIL_TEXTURE)
+		{
+		DEBUG_1("side-by-side stereo detection: %dx%d global %.3f, no detail -> mono", w, h, global);
+		return FALSE;
+		}
+
+	const gdouble detail = stereo_grid_local_ncc(left_detail, right_detail, grid_w, GRID_H, max_dx, 0);
+
+	/* 3. vertical alignment */
+	gdouble control = -1.0;
+	for (const gint dy : CONTROL_DY)
+		{
+		control = std::max(control, stereo_grid_local_ncc(left_detail, right_detail, grid_w, GRID_H, max_dx, dy));
+		}
+
+	const gboolean detected = detail >= MIN_DETAIL_CORRELATION && detail > control;
+
+	DEBUG_1("side-by-side stereo detection: %dx%d global %.3f detail %.3f control %.3f -> %s",
+	        w, h, global, detail, control, detected ? "stereo" : "mono");
+
+	return detected;
+}
+
