+/**
+ * @brief Run the side-by-side stereo detection once for a completely loaded pixbuf
+ *
+ * The result is kept on the pixbuf, so cached and read-ahead pixbufs are not examined again.
+ * The detection always runs (it takes much less than a millisecond), so that cached pixbufs
+ * are correct when options->stereo.detect_sbs is switched on; the option controls only the use of the result.
+ * Partially loaded pixbufs must not be passed here.
+ */
+static void image_stereo_detect(GdkPixbuf *pixbuf)
+{
+	if (!pixbuf) return;
+	if (g_object_get_data(G_OBJECT(pixbuf), "stereo_detect")) return;
+	if (g_object_get_data(G_OBJECT(pixbuf), "stereo_data")) return; /* known from the file format */
+
+	const gboolean sbs = pixbuf_detect_side_by_side_stereo(pixbuf);
+	g_object_set_data(G_OBJECT(pixbuf), "stereo_detect", GINT_TO_POINTER(sbs ? STEREO_PIXBUF_SBS : STEREO_PIXBUF_NONE));
+}
+
+/**
+ * @brief Stereo layout of a pixbuf: user selection, then file format, then content detection
+ */
+static StereoPixbufData image_stereo_data_get(const ImageWindow *imd, GdkPixbuf *pixbuf)
+{
+	if (!pixbuf) return STEREO_PIXBUF_DEFAULT;
+	if (imd->user_stereo != STEREO_PIXBUF_DEFAULT) return imd->user_stereo;
+
+	auto stereo_data = static_cast<StereoPixbufData>(GPOINTER_TO_INT(g_object_get_data(G_OBJECT(pixbuf), "stereo_data")));
+	if (stereo_data == STEREO_PIXBUF_DEFAULT && options->stereo.detect_sbs &&
+	    GPOINTER_TO_INT(g_object_get_data(G_OBJECT(pixbuf), "stereo_detect")) == STEREO_PIXBUF_SBS)
+		{
+		stereo_data = STEREO_PIXBUF_SBS;
+		}
+
+	return stereo_data;
+}
