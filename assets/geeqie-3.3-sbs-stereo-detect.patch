+/**
+ * @brief Get the view of a stereo pair that is shown in single image stereo mode
+ * @param pixbuf The source image
+ * @param stereo_data The layout of the source image
+ * @param swap TRUE to get the right view instead of the left view
+ * @returns A new reference: for a side-by-side source, a copy of one view;
+ * otherwise the complete pixbuf. NULL if pixbuf is NULL.
+ */
+GdkPixbuf *pixbuf_renderer_stereo_view_new(GdkPixbuf *pixbuf, StereoPixbufData stereo_data, gboolean swap)
+{
+	if (!pixbuf) return nullptr;
+
+	if (stereo_data != STEREO_PIXBUF_SBS && stereo_data != STEREO_PIXBUF_CROSS)
+		{
+		return g_object_ref(pixbuf);
+		}
+
+	const gint half_w = gdk_pixbuf_get_width(pixbuf) / 2;
+	const gint left_x = (stereo_data == STEREO_PIXBUF_SBS) ? 0 : half_w;
+	const gint right_x = half_w - left_x;
+
+	g_autoptr(GdkPixbuf) view = gdk_pixbuf_new_subpixbuf(pixbuf, swap ? right_x : left_x, 0,
+	                                                     half_w, gdk_pixbuf_get_height(pixbuf));
+
+	return gdk_pixbuf_copy(view);
+}
+
+/**
+ * @brief Get the image as it is seen in single image stereo mode
+ * @returns A new reference: for a side-by-side stereo source, a copy of the view
+ * that is shown in single image mode (the left view, or the right view if the views are swapped);
+ * otherwise the complete pixbuf. NULL if there is no pixbuf.
+ */
+GdkPixbuf *pixbuf_renderer_get_view_pixbuf(PixbufRenderer *pr)
+{
+	g_return_val_if_fail(IS_PIXBUF_RENDERER(pr), NULL);
+
+	return pixbuf_renderer_stereo_view_new(pr->pixbuf, pr->stereo_data, (pr->stereo_mode & PR_STEREO_SWAP) != 0);
+}
